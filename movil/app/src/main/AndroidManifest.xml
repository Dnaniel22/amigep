<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Amigep">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Rol cliente -->
        <activity android:name=".ui.cliente.ClienteActivity" />
        <activity android:name=".ui.cliente.RutinaActivity" />
        <activity android:name=".ui.cliente.EditarPerfilActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.cliente.RegistrarComidaActivity" android:windowSoftInputMode="adjustResize" />

        <!-- Rol entrenador -->
        <activity android:name=".ui.entrenador.EntrenadorActivity" />
        <activity android:name=".ui.entrenador.DetalleClienteActivity" />
        <activity android:name=".ui.entrenador.EditorRutinaActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.entrenador.AlimentacionClienteActivity" />

        <!-- Comunes -->
        <activity android:name=".ui.NotificacionesActivity" />
        <activity android:name=".ui.ReporteActivity" />
    </application>
</manifest>

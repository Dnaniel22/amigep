<?xml version="1.0" encoding="utf-8"?>
<!-- E1 · Mis clientes (RF-09, RF-16): solo los clientes asignados al entrenador -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margen"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/avatar"
            style="@style/Avatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nombreEntrenador"
                style="@style/Texto.Negrita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp" />

            <TextView
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entrenador" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnAgenda"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Agenda"
            android:padding="11dp"
            android:src="@drawable/ic_campana"
            app:tint="@color/texto" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/margen">

        <EditText
            android:id="@+id/buscar"
            style="@style/Entrada"
            android:hint="Buscar cliente..."
            android:imeOptions="actionSearch"
            android:inputType="textPersonName"
            android:paddingStart="46dp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_buscar"
            app:tint="@color/apagado" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filtros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/margen"
            android:paddingEnd="@dimen/margen" />
    </HorizontalScrollView>

    <TextView
        style="@style/Texto.Seccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen"
        android:layout_marginTop="10dp"
        android:text="Clientes asignados" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refrescar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/margen"
            android:paddingEnd="@dimen/margen"
            android:paddingBottom="20dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:id="@+id/vacio"
        style="@style/Texto.Secundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:gravity="center"
        android:visibility="gone" />
</LinearLayout>

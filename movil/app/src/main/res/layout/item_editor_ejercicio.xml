<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <EditText
        android:id="@+id/eeNombre"
        style="@style/Entrada"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_weight="2.4"
        android:hint="Press banca"
        android:inputType="textCapSentences"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/eeSeries"
        style="@style/Entrada"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="6dp"
        android:layout_weight="0.9"
        android:gravity="center"
        android:hint="4"
        android:inputType="number"
        android:maxLength="2"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/eeReps"
        style="@style/Entrada"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:gravity="center"
        android:hint="10"
        android:inputType="text"
        android:maxLength="8"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/eeEliminar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Quitar ejercicio"
        android:padding="7dp"
        android:src="@drawable/ic_cerrar"
        app:tint="@color/apagado" />
</LinearLayout>

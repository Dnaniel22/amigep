<?xml version="1.0" encoding="utf-8"?>
<!-- C1 · Inicio de sesión (RF-01, RNF-05): selector de rol cliente / entrenador -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/btnServidor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Configurar servidor"
            android:padding="9dp"
            android:src="@drawable/ic_servidor"
            app:tint="@color/apagado" />

        <TextView
            style="@style/Avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="A"
            android:textSize="24sp" />

        <TextView
            style="@style/Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="@string/app_name"
            android:textSize="22sp" />

        <TextView
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/lema"
            android:textSize="14sp" />

        <!-- Selector de rol -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_segmento"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/rolCliente"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Cliente"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rolEntrenador"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Entrenador"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/EtiquetaCampo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Correo electrónico" />

        <EditText
            android:id="@+id/correo"
            style="@style/Entrada"
            android:hint="tucorreo@ejemplo.com"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/EtiquetaCampo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contraseña" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/contrasena"
                style="@style/Entrada"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:paddingEnd="64dp" />

            <TextView
                android:id="@+id/verContrasena"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_gravity="end"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Ver"
                android:textColor="@color/apagado"
                android:textSize="13sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/olvide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="¿Olvidaste tu contraseña?"
            android:textColor="@color/turquesa"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnIngresar"
            style="@style/Boton.Turquesa"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:text="Iniciar sesión"
            app:icon="@drawable/ic_escudo" />

        <ProgressBar
            android:id="@+id/cargando"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/turquesa"
            android:visibility="gone" />

        <TextView
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/aviso_admin" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="40dp" />

        <TextView
            android:id="@+id/terminos"
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="11.5sp" />
    </LinearLayout>
</ScrollView>

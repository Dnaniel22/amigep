<?xml version="1.0" encoding="utf-8"?>
<!-- C5 · Alimentación IA (RF-12, RF-13, BPM Fig. 10). Recomendaciones orientativas (sección 8.7). -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refrescar"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            style="@style/Pantalla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.Titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recomendaciones IA"
                        android:textSize="18sp" />

                    <TextView
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plan nutricional personalizado" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnRegenerar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_ia"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Regenerar plan con IA"
                        android:src="@drawable/ic_ia"
                        app:tint="@color/turquesa" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sinPlan"
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Texto.Negrita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aún no tienes un plan nutricional" />

                <TextView
                    style="@style/Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="La IA calculará tu meta calórica y tus comidas según tu objetivo, peso y altura." />

                <Button
                    android:id="@+id/btnGenerarPlan"
                    style="@style/Boton.Turquesa"
                    android:layout_width="match_parent"
                    android:layout_marginTop="14dp"
                    android:text="Generar plan con IA"
                    app:icon="@drawable/ic_ia" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/listaComidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seguimiento de macros · hoy" />

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/pctProteinas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/turquesa"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Texto.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Proteínas" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/pctCarbohidratos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/dorado"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Texto.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Carbohidratos" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/pctGrasas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/rojo"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Texto.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Grasas" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/barraCalorias"
                    style="@style/Barra"
                    android:layout_marginTop="16dp"
                    android:progressDrawable="@drawable/progreso_dorado" />

                <TextView
                    android:id="@+id/caloriasHoy"
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_sugerencia"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ia"
                    app:tint="@color/turquesa" />

                <TextView
                    android:id="@+id/sugerencia"
                    style="@style/Texto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <TextView
                style="@style/Texto.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/aviso_nutricional" />

            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Objetivo nutricional" />

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_objetivo"
                    app:tint="@color/texto" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/objetivoNutricional"
                        style="@style/Texto.Negrita"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/objetivoDetalle"
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tituloRegistros"
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registrado hoy" />

            <LinearLayout
                android:id="@+id/listaRegistros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnRegistrarComida"
                style="@style/Boton.Borde"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="Registrar comida"
                app:icon="@drawable/ic_mas" />
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

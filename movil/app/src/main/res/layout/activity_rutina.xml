<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de la rutina activa del cliente (RF-09: seguimiento de cumplimiento) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/barra_superior" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contenidoRutina"
            style="@style/Pantalla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rNombre"
                        style="@style/Texto.Titulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/rEstado"
                        style="@style/Insignia" />
                </LinearLayout>

                <TextView
                    android:id="@+id/rDetalle"
                    style="@style/Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <ProgressBar
                    android:id="@+id/rBarra"
                    style="@style/Barra"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/rCumplimiento"
                    style="@style/Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/listaDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/rNotas"
                style="@style/Texto.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnCompletar"
        style="@style/Boton.Turquesa"
        android:layout_width="match_parent"
        android:layout_marginStart="@dimen/margen"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/margen"
        android:layout_marginBottom="16dp"
        android:text="Marcar sesión de hoy como completada"
        app:icon="@drawable/ic_check" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- E2 · Detalle de cliente y rutina (RF-06, RF-08, RF-09, RF-14) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/barra_superior" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refrescar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                style="@style/Pantalla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <LinearLayout
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dAvatar"
                        style="@style/Avatar"
                        android:layout_width="44dp"
                        android:layout_height="44dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/dNombre"
                            style="@style/Texto.Negrita"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/dObjetivo"
                            style="@style/Texto.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dTarjetaRutina"
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/dRutina"
                            style="@style/Texto.Negrita"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/dRutinaEstado"
                            style="@style/Insignia" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dRutinaDetalle"
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />

                    <ProgressBar
                        android:id="@+id/dRutinaBarra"
                        style="@style/Barra"
                        android:layout_marginTop="12dp" />
                </LinearLayout>

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Progreso reciente" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Tarjeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Peso actual" />

                        <TextView
                            android:id="@+id/dPeso"
                            style="@style/Texto.Valor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        style="@style/Tarjeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Asistencia" />

                        <TextView
                            android:id="@+id/dAsistencia"
                            style="@style/Texto.Valor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/dMembresia"
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Últimas asistencias" />

                <LinearLayout
                    android:id="@+id/dAsistencias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reportes del cliente" />

                <include
                    android:id="@+id/dReporteProgreso"
                    layout="@layout/item_opcion" />

                <include
                    android:id="@+id/dReporteAlimentacion"
                    layout="@layout/item_opcion" />
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margen"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/margen"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnActualizarRutina"
            style="@style/Boton.Turquesa"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Actualizar rutina"
            app:icon="@drawable/ic_editar" />

        <Button
            android:id="@+id/btnVerAlimentacion"
            style="@style/Boton.Borde"
            android:layout_width="0dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Ver alimentación" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema oscuro con acentos dorado (premium / navegación activa) y turquesa (IA / estados positivos) -->
    <style name="Theme.Amigep" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/turquesa</item>
        <item name="colorOnPrimary">@color/turquesa_texto</item>
        <item name="colorSecondary">@color/dorado</item>
        <item name="colorAccent">@color/turquesa</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/tarjeta</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/apagado</item>
        <item name="android:textColorHint">@color/apagado</item>
        <item name="colorControlActivated">@color/turquesa</item>
        <item name="alertDialogTheme">@style/Dialogo</item>
        <item name="materialAlertDialogTheme">@style/Dialogo</item>
    </style>

    <style name="Dialogo" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">@color/turquesa</item>
        <item name="android:windowBackground">@drawable/bg_dialogo</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="buttonBarPositiveButtonStyle">@style/BotonDialogo</item>
        <item name="buttonBarNegativeButtonStyle">@style/BotonDialogo.Neutro</item>
        <item name="buttonBarNeutralButtonStyle">@style/BotonDialogo.Neutro</item>
    </style>

    <style name="BotonDialogo" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/turquesa</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BotonDialogo.Neutro">
        <item name="android:textColor">@color/texto_2</item>
    </style>
</resources>

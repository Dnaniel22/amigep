# Copie este archivo como amigep.env (no se sube al repositorio) y cambie las claves.
DB_URL=jdbc:postgresql://localhost:5432/amigep
DB_USER=amigep
DB_PASSWORD=cambiar-clave-bd
# Clave para firmar los tokens: aleatoria y de al menos 32 caracteres
JWT_SECRET=cambiar-por-una-clave-aleatoria-de-al-menos-32-caracteres
ADMIN_EMAIL=admin@angelsgym.pe
ADMIN_PASSWORD=cambiar-clave-admin
# true solo para la demostración: carga los datos de prueba si la base de datos está vacía
DATOS_DEMO=false
PORT=8080
LOG_FILE=logs/amigep.log
MODELO_ABANDONO=data/modelo-abandono.json
